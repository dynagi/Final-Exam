{
  "expo": {
    "name": "SecureAIExam",
    "slug": "exam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F6FB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.secureaiexam.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "SecureAIExam uses the camera to scan question-paper QR codes at the exam center."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SecureAIExam records the device's location at the moment a QR is scanned, so every scan's location is on record."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e85a3942-6e5f-43af-a1a9-402f626a9e65"
      }
    },
    "owner": "sarveshshimpi-org"
  }
}
